server:
    port: 5000
    # CORS 白名单；同域部署（Go 直接托管前端）可留空
    allowed_origins: []
database:
    host: 127.0.0.1
    port: 5432
    user: postgres
    password: ""
    name: authcenter
    # 本机直连通常使用 disable；公网或托管 PostgreSQL 应使用 require/verify-full
    ssl_mode: disable
    timezone: Asia/Shanghai
    # auto_create=true 时通过此维护库创建目标数据库，账号需要 CREATEDB 权限
    maintenance_db: postgres
    auto_create: true
jwt:
    # 留空则首次启动自动生成并写回
    secret: ""
admin:
    # 首次启动种子管理员（仅数据库无管理员时生效），首次登录会被强制修改密码
    username: admin
    password: admin123
# SMTP 邮件发送（兜底配置，运行时可在后台 - 邮件配置覆盖）
smtp:
    host: ""
    port: 465
    user: ""
    password: ""
    from_name: "授权中心"
# 站点信息
site:
    # 公网地址，用于拼接支付回调 URL（如 https://auth.example.com）
    base_url: ""
    name: "授权中心"
# 更新包存储目录（相对 backend 根目录或绝对路径）
release_dir: ./release
